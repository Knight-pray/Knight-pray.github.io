{{- /* RSS: posts only (home), or the page's own posts (category / tag / section). */ -}}
{{- $pages := .Pages -}}
{{- if .IsHome -}}{{- $pages = where site.RegularPages "Section" "posts" -}}
{{- else if .IsSection -}}{{- $pages = .RegularPagesRecursive -}}
{{- else if and (eq .Kind "term") (eq .Data.Plural "categories") -}}{{- $pages = partial "func/term-pages.html" .Title -}}
{{- end -}}
{{- $pages = first 20 $pages -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.LanguageCode }}</language>
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- $tp := partial "func/title-parts.html" . }}
    <item>
      <title>{{ $tp.full }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Description | default .Summary | html }}</description>
      {{- range .GetTerms "categories" }}
      <category>{{ .Title }}</category>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
